# Alternative: Use environment variables (most secure)
# Set these in your system environment:
#
# Windows PowerShell:
# $env:GOOGLE_ADS_GEBEAUTY_DEVELOPER_TOKEN="your_token"
# $env:GOOGLE_ADS_GEBEAUTY_CLIENT_ID="your_client_id"
# $env:GOOGLE_ADS_GEBEAUTY_CLIENT_SECRET="your_client_secret"
# $env:GOOGLE_ADS_GEBEAUTY_REFRESH_TOKEN="your_refresh_token"
# $env:GOOGLE_ADS_GEBEAUTY_CUSTOMER_ID="your_customer_id"
#
# Linux/Mac:
# export GOOGLE_ADS_GEBEAUTY_DEVELOPER_TOKEN="your_token"
# export GOOGLE_ADS_GEBEAUTY_CLIENT_ID="your_client_id"
# export GOOGLE_ADS_GEBEAUTY_CLIENT_SECRET="your_client_secret"
