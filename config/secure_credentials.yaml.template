# SECURE CREDENTIALS TEMPLATE
# 
# ⚠️  SECURITY WARNING: This file contains sensitive API credentials
# 
# 1. Copy this file to config/secure_credentials.yaml
# 2. Add config/secure_credentials.yaml to .gitignore
# 3. Fill in your actual Google Ads API credentials
# 4. NEVER commit this file to version control
#
# Example .gitignore entry:
# config/secure_credentials.yaml
# **/credentials.yaml
# **/secure.yaml

brands:
  gebeauty:
    google_ads:
      developer_token: "your_actual_developer_token_here"
      client_id: "your_actual_client_id_here"
      client_secret: "your_actual_client_secret_here"
      refresh_token: "your_actual_refresh_token_here"
      customer_id: "your_actual_customer_id_here"
  
